<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="600"
        Width="650" Height="620"
        MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        x:Class="UI.Views.BookmarkExportWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Bookmark JSON export">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Brave Browser Backup"
                       FontSize="20"
                       FontWeight="Bold" />
            <TextBlock Text="Export/Import/Sync data for Brave Browser and between profiles."
                       Foreground="Gray" />
        </StackPanel>

        <!-- Main Form Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Step 1: Select Application Channel -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="1. Select Brave Browser"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshCommand}"
                                    Padding="10,4" />
                        </Grid>

                        <ComboBox ItemsSource="{Binding DetectedApps}"
                                  SelectedItem="{Binding SelectedApp}"
                                  PlaceholderText="{Binding AppSelectionPlaceholder}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:AppChannelItem">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Spacing="4"
                                    Margin="4,0,0,0">
                            <TextBlock Text="{Binding DataDirectoryText}"
                                       FontSize="11"
                                       Foreground="Gray"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2: Select Profile -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="2. Select Profile to Export"
                                   FontWeight="SemiBold" />

                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 MinHeight="100"
                                 MaxHeight="180">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="vm:ProfileItem">
                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                </Style>
                                <Style Selector="TextBlock.profile-name.highlighted" x:DataType="vm:ProfileItem">
                                    <Setter Property="Foreground" Value="{Binding ProfileNameForeground}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:ProfileItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                                        <Grid Grid.Column="0"
                                              Width="34"
                                              Height="34"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding ProfileInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Border Width="32"
                                                    Height="32"
                                                    CornerRadius="16"
                                                    Background="{Binding AvatarFillBrush}"
                                                    BorderBrush="{Binding AvatarStrokeBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding IsPlaceholderAvatar}">
                                                <Grid>
                                                    <Ellipse Width="10"
                                                             Height="10"
                                                             Stroke="{Binding AvatarStrokeBrush}"
                                                             StrokeThickness="1.5"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top"
                                                             Margin="0,6,0,0" />
                                                    <Border Width="18"
                                                            Height="10"
                                                            CornerRadius="9,9,0,0"
                                                            BorderBrush="{Binding AvatarStrokeBrush}"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,0,0,5" />
                                                </Grid>
                                            </Border>
                                            <Image Width="32"
                                                   Height="32"
                                                   Source="{Binding AvatarImage}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding AvatarImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="Medium"
                                                       Classes="profile-name"
                                                       Classes.highlighted="{Binding ProfileNameForeground, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Text="{Binding ProfileDirectoryText}"
                                                       FontSize="11"
                                                       Foreground="Gray"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding ProfileInfo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusDescription}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#B9A6DE"
                                                   IsVisible="{Binding StatusDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Step 3: Destination File -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="3. Export Destination File"
                                   FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <TextBox Grid.Column="0"
                                     Text="{Binding TargetFilePath}"
                                     PlaceholderText="Enter destination file path (e.g. bookmarks.json)"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Command="{Binding BrowseExportPathCommand}"
                                    Padding="14,6" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Export Action Button -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Export Bookmarks"
                    Command="{Binding ExportBookmarksCommand}"
                    HorizontalAlignment="Right"
                    Padding="20,10"
                    FontWeight="SemiBold"
                    Classes="accent" />
        </Grid>
    </Grid>

</Window>