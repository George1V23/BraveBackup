<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:UI.Views"
        xmlns:vm="using:UI.ViewModels"
        x:Class="UI.Views.BookmarkExportWindow"
        x:DataType="vm:MainViewModel"
        Width="650" Height="620" MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterScreen" Icon="/Assets/avalonia-logo.ico"
        Title="Bookmark export">
    <views:BookmarkExportView Margin="20" />
</Window>