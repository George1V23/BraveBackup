<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UI.ViewModels"
             xmlns:views="using:UI.Views"
             x:Class="UI.Views.RestorePreviewView" x:DataType="vm:RestorePreviewViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,18,0,18">
          <Border Classes="card" IsVisible="{Binding HasRestoreOutcome}">
              <StackPanel Spacing="10">
                  <TextBlock Text="{Binding RestoreStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding RestoreProgress}"
                               IsIndeterminate="{Binding !HasProgressTotal}" IsVisible="{Binding IsRestoreActive}" />
                  <TextBlock Text="{Binding RestoreCounts}" TextWrapping="Wrap"
                             IsVisible="{Binding RestoreCounts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <SelectableTextBlock Text="{Binding RestoreReport}" TextWrapping="Wrap"
                                       IsVisible="{Binding RestoreReport, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <SelectableTextBlock Text="{Binding RestoreErrorCode}"
                                       IsVisible="{Binding RestoreErrorCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel IsVisible="{Binding HasPublishedSafety}" Spacing="6">
                      <TextBlock Text="Encrypted safety backup" />
                      <SelectableTextBlock Text="{Binding PublishedSafetyPath}" TextWrapping="Wrap" />
                      <Button Content="Open safety-backup folder" Command="{Binding OpenSafetyFolderCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal">
                      <Button Content="Cancel restore" Command="{Binding CancelRestoreCommand}"
                              IsVisible="{Binding ShowCancelRestore}" Margin="0,0,8,0" />
                      <Button Content="Resume restoration" Command="{Binding ResumeRestoreCommand}"
                              IsVisible="{Binding IsRestorePaused}" Margin="0,0,8,0" />
                      <Button Content="Review rollback" Command="{Binding OfferRollbackCommand}" IsVisible="{Binding RecoveryAvailable}" />
                  </WrapPanel>
                  <StackPanel IsVisible="{Binding IsRollbackPromptVisible}" Spacing="8">
                      <TextBlock Text="Roll back changes made by this restore using its original safety backup?" TextWrapping="Wrap" />
                      <WrapPanel Orientation="Horizontal">
                          <Button Content="Decline rollback" Command="{Binding DeclineRollbackCommand}" Margin="0,0,8,0" />
                          <Button Content="Confirm rollback" Command="{Binding ConfirmRollbackCommand}" />
                      </WrapPanel>
                  </StackPanel>
              </StackPanel>
          </Border>
          <StackPanel Spacing="14" IsVisible="{Binding CanEditRestore}">
            <Expander Header="Roll back a previous restore" IsVisible="{Binding SupportsRestartRollback}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Close Brave. Choose the encrypted restart record from the same system boot. Keep its safety backup and journal in the same folder." TextWrapping="Wrap" Classes="muted" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding RestartRecordPath}" PlaceholderText="Choose a .restart.encrypted file" />
                        <Button Grid.Column="1" Content="Browse restart record…" Command="{Binding BrowseRestartRecordCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBox Text="{Binding RestartSafetyPassword}" PasswordChar="●" PlaceholderText="Safety-backup password" />
                    <Button Content="Review previous rollback" Command="{Binding ReviewRestartRollbackCommand}" HorizontalAlignment="Left" />
                    <SelectableTextBlock Text="{Binding RestartReviewText}" TextWrapping="Wrap" />
                    <WrapPanel IsVisible="{Binding HasRestartReview}">
                        <Button Content="Cancel rollback review" Command="{Binding CancelRestartReviewCommand}" Margin="0,0,8,0" />
                        <Button Content="Confirm previous rollback" Command="{Binding ConfirmRestartRollbackCommand}" Classes="accent" />
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Backup file" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding SourcePath}" PlaceholderText="Choose a .bravebackup file" />
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <SelectableTextBlock Text="{Binding FullSourcePath}" TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding NeedsUnlock}" Spacing="8">
                        <TextBlock Text="Encrypted backup password" />
                        <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Password" />
                        <Button Content="Unlock backup" Command="{Binding UnlockCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
            </Border>
            <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Installations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RestoreInstallationPreview">
                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RestoreProfilePreview">
                                            <StackPanel Spacing="6" Margin="12,0,0,14">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DirectoryName}" Classes="muted" />
                                                <ItemsControl ItemsSource="{Binding Categories}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RestoreCategoryPreview">
                                                            <StackPanel Spacing="2" Margin="12,0,0,8">
                                                                <TextBlock Text="{Binding Label}" />
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <views:RestorePlanningView DataContext="{Binding Planning}" />
            <views:RestoreSafetyOptionsView DataContext="{Binding Safety}" />
            <Button Content="Review restore" Command="{Binding ReviewRestoreCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding ReviewError}" TextWrapping="Wrap" />
            <Border Classes="card" IsVisible="{Binding HasReview}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Review restore" Classes="section" />
                    <SelectableTextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="Confirm to verify a safety backup and apply the listed changes." TextWrapping="Wrap" Classes="muted" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Cancel review" Command="{Binding CancelReviewCommand}" Margin="0,0,8,0" />
                        <Button Content="Confirm restore" Command="{Binding ConfirmRestoreCommand}" Classes="accent" />
                    </WrapPanel>
                </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
