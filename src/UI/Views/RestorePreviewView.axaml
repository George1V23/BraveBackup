<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UI.ViewModels"
             x:Class="UI.Views.RestorePreviewView" x:DataType="vm:RestorePreviewViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="0,18,0,18">
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Backup file" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding SourcePath}" PlaceholderText="Choose a .bravebackup file" />
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <SelectableTextBlock Text="{Binding FullSourcePath}" TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding NeedsUnlock}" Spacing="8">
                        <TextBlock Text="Encrypted backup password" />
                        <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Password" />
                        <Button Content="Unlock backup" Command="{Binding UnlockCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
            </Border>
            <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Installations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RestoreInstallationPreview">
                        <Border Classes="card" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RestoreProfilePreview">
                                            <StackPanel Spacing="6" Margin="12,0,0,14">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DirectoryName}" Classes="muted" />
                                                <ItemsControl ItemsSource="{Binding Categories}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RestoreCategoryPreview">
                                                            <StackPanel Spacing="2" Margin="12,0,0,8">
                                                                <TextBlock Text="{Binding Label}" />
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
