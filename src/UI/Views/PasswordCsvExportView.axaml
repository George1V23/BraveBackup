<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UI.ViewModels"
             x:Class="UI.Views.PasswordCsvExportView"
             x:DataType="vm:PasswordCsvExportViewModel">
    <Border Classes="card" Margin="0,8,0,18">
        <StackPanel Spacing="12">
            <TextBlock Text="Password CSV" FontWeight="SemiBold" />
            <TextBlock Text="Uses the profile selected above. Plaintext CSV is readable by anyone with file access. No credential preview is shown."
                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="8">
                <TextBlock Text="Password source" FontSize="11" />
                <ComboBox ItemsSource="{Binding PasswordSources}" SelectedItem="{Binding SelectedPasswordSource}"
                          PlaceholderText="Choose a supported source" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:PasswordSourceOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding PasswordSourceDescription}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="CSV destination for this profile" FontSize="11" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding Destination}" PlaceholderText="Choose a local .csv file" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseDestinationCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="Full destination path" Classes="muted" FontSize="11" />
                <SelectableTextBlock Text="{Binding FullDestination}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
            <TextBlock Text="{Binding Availability}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Cancel CSV export" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                <Button Content="Export password CSV" Command="{Binding ExportCsvCommand}" Classes="accent" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding Report}" TextWrapping="Wrap" FontSize="11" />
            <SelectableTextBlock Text="{Binding CompletedDestination}" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
    </Border>
</UserControl>
